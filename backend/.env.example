# BUSORA Environment Configuration

# Application Secret
SECRET_KEY=busora-kerala-smart-transit-secret-key-2026
JWT_SECRET_KEY=jwt-secret-token-key-busora-9988
JWT_EXPIRATION_HOURS=24

# Database Mode: "sqlite" (default zero-config) or "mysql"
DB_TYPE=sqlite

# MySQL Configuration (Used when DB_TYPE=mysql)
MYSQL_USER=busora_user
MYSQL_PASSWORD=busora_password
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DB=busora_db

# Real-Time Tracking & Simulation
DEMO_MODE=true
GPS_STALE_THRESHOLD_SECONDS=300
GPS_OFFLINE_THRESHOLD_SECONDS=900

# CORS & Server
PORT=5000
FRONTEND_URL=http://localhost:5173
